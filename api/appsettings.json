{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RuleGenerator": {
    "Deployment": "gpt-4.1-mini"
  },
  "DailyAiLimit": {
    "PerUser": 30,
    "AllUsers": 300
  },
  "PasswordResetLimit": {
    "PerAddressMinutes": 5,
    "PerDay": 50
  }
}
